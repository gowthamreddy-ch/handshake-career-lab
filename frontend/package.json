{
  "name": "handshake-career-lab-frontend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": { "@types/node": "22.20.5", "@types/react": "19.3.0", "@types/react-dom": "19.3.0", "typescript": "7.0.2", "vite": "8.3.4" },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4190 --strictPort",
    "start": "npm run dev",
    "build": "tsc --noEmit && vite build",
    "build:pages": "tsc --noEmit && vite build --mode pages",
    "preview": "vite preview --host 127.0.0.1 --port 4190 --strictPort",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/tests/*.test.js"
  }
}
